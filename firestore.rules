rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // غيّر الإيميل ده لإيميل Gmail بتاعك (اللي هتدخل بيه على لوحة المتابعة)
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'PUT_YOUR_EMAIL_HERE@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /users/{uid} {
      // أنت بس اللي تقرا بيانات الناس
      allow read: if isAdmin();

      // كل واحد يكتب مستند واحد خاص بيه بس، وبحقول محددة
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','daily','prayers','wird','extras','pages','juz','streak','pct','day','rmStart','visitDays','joinedAt','consent','lastSeen','ver'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 30
        && request.resource.data.consent == true
        && request.resource.data.daily is list
        && request.resource.data.daily.size() == 29;

      // المستخدم يحذف بياناته، وأنت كمان
      allow delete: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }
  }
}
